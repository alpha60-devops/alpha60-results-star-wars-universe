<!-- Live region for screen reader sort announcements -->
<div class="sr-only" aria-live="polite" id="sort-announcement"></div>

<script>
// Enhanced WCAG 2.2 sort function with ARIA announcements
function sortTable(tableId, colIndex) {
  const table = document.getElementById(tableId);
  if (!table) return;

  const tbody = table.tBodies[0];
  if (!tbody) return;

  const rows = Array.from(tbody.rows);
  const currentSort = table.getAttribute('data-sort-col');
  const currentAsc = table.getAttribute('data-sort-asc') === 'true';
  
  // Determine sort direction
  let ascending;
  if (currentSort === String(colIndex)) {
    ascending = !currentAsc;
  } else {
    ascending = true;
  }
  
  // Store sort state
  table.setAttribute('data-sort-col', colIndex);
  table.setAttribute('data-sort-asc', ascending);
  
  // Get column header cell
  const headerRow = table.tHead.rows;
  let headerCell = null;
  for (let i = 0; i < headerRow.length; i++) {
    const cells = headerRow[i].cells;
    for (let j = 0; j < cells.length; j++) {
      if (cells[j].getAttribute('onclick')?.includes(`sortTable('${tableId}', ${colIndex})`)) {
        headerCell = cells[j];
        break;
      }
    }
  }
  
  // Clear all sort indicators
  document.querySelectorAll(`#${tableId} th .sort-indicator`).forEach(ind => {
    ind.textContent = '';
    ind.className = 'sort-indicator';
  });
  
  // Update sort indicator
  if (headerCell) {
    const indicator = headerCell.querySelector('.sort-indicator');
    if (indicator) {
      indicator.textContent = ascending ? ' ▲' : ' ▼';
      indicator.className = `sort-indicator sort-${ascending ? 'asc' : 'desc'}`;
      headerCell.setAttribute('aria-label', 
        `${headerCell.textContent.replace(/[▲▼]/g, '').trim()}, sorted ${ascending ? 'ascending' : 'descending'}`
      );
    }
  }
  
  // Sort rows
  rows.sort((a, b) => {
    let x = a.cells[colIndex]?.innerText.trim() || '';
    let y = b.cells[colIndex]?.innerText.trim() || '';
    
    const xNum = parseNumber(x);
    const yNum = parseNumber(y);
    
    if (xNum !== null && yNum !== null) {
      return ascending ? xNum - yNum : yNum - xNum;
    }
    return ascending ? x.localeCompare(y) : y.localeCompare(x);
  });
  
  // Reorder rows
  rows.forEach(row => tbody.appendChild(row));
  
  // Announce sort for screen readers
  const columnName = headerCell ? headerCell.textContent.replace(/[▲▼]/g, '').trim() : `Column ${colIndex + 1}`;
  const direction = ascending ? 'ascending' : 'descending';
  const announcement = document.getElementById('sort-announcement');
  if (announcement) {
    announcement.textContent = `${columnName} sorted ${direction}.`;
  }
}

// Keyboard handler for Enter/Space
function handleKeySort(event, tableId, colIndex) {
  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault();
    sortTable(tableId, colIndex);
  }
}

// Number parser (from your existing script)
function parseNumber(str) {
  if (!str) return null;
  const cleaned = str.replace(/,/g, '').trim();
  if (cleaned === '' || isNaN(cleaned)) return null;
  const num = Number(cleaned);
  return isNaN(num) ? null : num;
}

// Initialize ARIA sort states on page load
document.addEventListener('DOMContentLoaded', function() {
  const table = document.getElementById('t-mo');
  if (table && table.tHead) {
    const headers = table.querySelectorAll('th[onclick]');
    headers.forEach(header => {
      if (!header.hasAttribute('tabindex')) {
        header.setAttribute('tabindex', '0');
        header.setAttribute('role', 'button');
      }
    });
  }
});
</script>

